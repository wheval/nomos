{
  "name": "nomos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shield:list": "tsx scripts/shield-reconcile.ts list",
    "shield:mark": "tsx scripts/shield-reconcile.ts mark",
    "setup:sepolia": "node scripts/network-setup.mts --network sepolia",
    "setup:mainnet": "node scripts/network-setup.mts --network mainnet",
    "postinstall": "fumadocs-mdx",
    "reconcile": "node -e \"const s=process.env.NOMOS_SHIELD_WORKER_SECRET;const n=process.argv[1]||2;fetch('http://localhost:3000/api/internal/reconcile?network='+n,{headers:{authorization:'Bearer '+s}}).then(r=>r.json()).then(d=>console.log(JSON.stringify(d,null,2)))\""
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@starknet-io/get-starknet-discovery": "6.0.2",
    "@starknet-io/get-starknet-wallet-standard": "6.0.2",
    "@starkware-libs/starknet-privacy-sdk": "0.14.3-rc.5",
    "@supabase/supabase-js": "^2.112.4",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.15.4",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.4",
    "lucide-react": "^1.34.0",
    "next": "^16.0.8",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "shadcn": "^4.19.0",
    "sharp": "^0.34.5",
    "starknet": "10.4.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@starknet-io/types-js": "0.10.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "resolutions": {
    "@starknet-io/get-starknet-wallet-standard": "6.0.2"
  }
}
