# Copy this file to .env.local and fill in your values.

# Alchemy Starknet RPC key — used by the mainnet + sepolia providers in
# src/utils/constants.ts. Get one free at https://alchemy.com. The URL prefix is
# already set in constants.ts; paste ONLY the key here.
NEXT_PUBLIC_PROVIDER_URL=your_alchemy_key_here

# (Optional) Your echo/anonymizer helper deployed on Sepolia — enables the Echo
# action there. Leave as 0x0 if not deployed; you can deploy one from the Echo tab
# in the app and paste the returned address here.
NEXT_PUBLIC_STRK20_ECHO_HELPER_SEPOLIA=0x0

# Ledger storage driver: memory (tests/CI) | file (local dev, .data/*.json,
# not durable on Vercel) | supabase (real deployments). Defaults to "file"
# if unset. See docs/ARCHITECTURE.md "Storage".
NOMOS_STORE_DRIVER=file

# Required only when NOMOS_STORE_DRIVER=supabase. From your Supabase
# project's API settings — use the service_role key, not the anon key (this
# runs server-side only, never exposed to the client).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Nomos's own operating wallet — receives both payment flows, shields Flow B
# deposits, and executes payouts. Deployed on Sepolia — see cairo/address.md.
# NEVER set the private key as NEXT_PUBLIC_* — it must only ever exist
# server-side. The address is public info (both flows' recipient), so it's
# also exposed to the client via the NEXT_PUBLIC_ copy below.
NOMOS_OPERATING_WALLET_ADDRESS=
NOMOS_OPERATING_WALLET_PRIVKEY=
NEXT_PUBLIC_NOMOS_OPERATING_WALLET_ADDRESS=

# Bearer secret for /api/internal/shield — the manual shield-reconciliation
# endpoint a team member uses after shielding Flow B deposits by hand (see
# scripts/shield-reconcile.ts and docs/ARCHITECTURE.md). Generate any
# random string; never NEXT_PUBLIC_*.
NOMOS_SHIELD_WORKER_SECRET=
